            igmp_version = {{$networkEntry.IgmpVersion}}
            {{- end}}
            {{- if $networkEntry.Attachments}}
            attachments = {
                {{- range $serial, $attachEntry := $networkEntry.Attachments}}
                "{{$serial}}" = {
                    deploy_this_attachment = {{$attachEntry.DeployThisAttachment}}
                }
                {{- end}}
            }
            {{- end}}
        }
    {{- end}}
    }
}
{{end}}
{{end}}
{{end}}

{{/* Template for generating VXLAN fabrics and inventory devices for MSD test setup */}}

{{define "NDFC_VXLAN_FABRICS_AND_INVENTORY"}}
# =============================================================================
# VXLAN EVPN Fabrics (Child fabrics for MSD)
# =============================================================================
{{range .VxlanFabrics}}
resource "ndfc_fabric_vxlan_evpn" "{{.ResourceName}}" {
    fabric_name = "{{.FabricName}}"
    bgp_as      = "{{.BgpAs}}"
    deploy      = {{.Deploy}}
}
{{end}}

# =============================================================================
# Inventory Devices for each child fabric
# =============================================================================
{{range .InventoryDevices}}
resource "ndfc_inventory_devices" "{{.ResourceName}}" {
    {{if .DependsOn}}depends_on = [{{.DependsOn}}]{{end}}
    fabric_name     = "{{.FabricName}}"
    auth_protocol   = "{{.AuthProtocol}}"
    username        = "{{.Username}}"
    password        = "{{.Password}}"
    max_hops        = {{.MaxHops}}
    preserve_config = {{.PreserveConfig}}
    save            = {{.Save}}
    deploy          = {{.Deploy}}
    retries         = {{.Retries}}
    retry_wait_timeout = {{.RetryWaitTime}}
    devices = {
    {{- range $deviceIp, $deviceEntry := .Devices}}
        "{{$deviceIp}}" = {
            role                    = "{{$deviceEntry.Role}}"
            discovery_type          = "{{$deviceEntry.DiscoveryType}}"
            discovery_auth_protocol = "{{$deviceEntry.DiscoveryAuthProtocol}}"
        }
    {{- end}}
    }
}
{{end}}
{{end}}

{{/* =============================================================================
     UNIFIED MSD COMPREHENSIVE TEST TEMPLATE
     Generates all resources for MSD comprehensive test in one structure
     ============================================================================= */}}
{{define "NDFC_MSD_COMPREHENSIVE_TEST"}}
# =============================================================================
# VXLAN EVPN Fabrics (Child fabrics for MSD)
# =============================================================================
{{range .VxlanFabrics}}
resource "ndfc_fabric_vxlan_evpn" "{{.ResourceName}}" {
    fabric_name = "{{.FabricName}}"
    bgp_as      = "{{.BgpAs}}"
    deploy      = {{.Deploy}}
}
{{end}}

# =============================================================================
# Inventory Devices for each child fabric
# =============================================================================
{{range .InventoryDevices}}
resource "ndfc_inventory_devices" "{{.ResourceName}}" {
    {{if .DependsOn}}depends_on = [{{.DependsOn}}]{{end}}
    fabric_name     = "{{.FabricName}}"
    auth_protocol   = "{{.AuthProtocol}}"
    username        = "{{.Username}}"
    password        = "{{.Password}}"
    max_hops        = {{.MaxHops}}
    preserve_config = {{.PreserveConfig}}
    save            = {{.Save}}
    deploy          = {{.Deploy}}
    retries         = {{.Retries}}
    retry_wait_timeout = {{.RetryWaitTime}}
    devices = {
    {{- range $deviceIp, $deviceEntry := .Devices}}
        "{{$deviceIp}}" = {
            role                    = "{{$deviceEntry.Role}}"
            discovery_type          = "{{$deviceEntry.DiscoveryType}}"
            discovery_auth_protocol = "{{$deviceEntry.DiscoveryAuthProtocol}}"
        }
    {{- end}}
    }
}
{{end}}

# =============================================================================
# MSD Fabric
# =============================================================================
{{with .MsdFabric}}
resource "ndfc_fabric_vxlan_msd" "{{.ResourceName}}" {
    {{if .DependsOn}}depends_on = [{{.DependsOn}}]{{end}}
    fabric_name   = "{{.FabricName}}"
    deploy        = {{.Deploy}}
    {{if .ChildFabrics}}child_fabrics = [{{range $i, $cf := .ChildFabrics}}{{if $i}}, {{end}}"{{$cf}}"{{end}}]{{end}}
}
{{end}}

# =============================================================================
# MSD Parent VRFs - Basic configuration with fabric field in attachments
# =============================================================================
{{with .MsdParentVrfs}}
{{if .Vrfs}}
resource "ndfc_vrfs" "{{.ResourceName}}" {
    {{if .DependsOn}}depends_on = [{{.DependsOn}}]{{end}}
    fabric_name = "{{.FabricName}}"
    {{if .DeployAllAttachments}}deploy_all_attachments = {{.DeployAllAttachments}}{{end}}
    vrfs = {
    {{- range $vrfName, $vrfEntry := .Vrfs}}
        "{{$vrfName}}" = {
            {{- if $vrfEntry.VrfId}}
            vrf_id = {{$vrfEntry.VrfId}}
            {{- end}}
            {{- if $vrfEntry.VlanId}}
            vlan_id = {{$vrfEntry.VlanId}}
            {{- end}}
            {{- if $vrfEntry.DisableRtAuto}}
            disable_rt_auto = {{$vrfEntry.DisableRtAuto}}
            {{- end}}
            {{- if $vrfEntry.Ipv6LinkLocal}}
            ipv6_link_local = {{$vrfEntry.Ipv6LinkLocal}}
            {{- end}}
            {{- if $vrfEntry.LoopbackRoutingTag}}
            loopback_routing_tag = {{$vrfEntry.LoopbackRoutingTag}}
            {{- end}}
            {{- if $vrfEntry.MaxBgpPaths}}
            max_bgp_paths = {{$vrfEntry.MaxBgpPaths}}
            {{- end}}
            {{- if $vrfEntry.MaxIbgpPaths}}
            max_ibgp_paths = {{$vrfEntry.MaxIbgpPaths}}
            {{- end}}
            {{- if $vrfEntry.Mtu}}
            mtu = {{$vrfEntry.Mtu}}
            {{- end}}
            {{- if $vrfEntry.RedistributeDirectRouteMap}}
